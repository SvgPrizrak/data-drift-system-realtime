KAFKA_BOOTSTRAP_SERVERS=kafka:19092
KAFKA_TOPIC=features-stream
KAFKA_GROUP_ID=drift-consumer
KAFKA_AUTO_OFFSET_RESET=earliest
WINDOW_SIZE=1000
MIN_WINDOW_SIZE=300
ANALYZE_EVERY_N_EVENTS=1
LATE_EVENT_THRESHOLD_SECONDS=60
STREAM_WARNING_LAG_SECONDS=60
STREAM_CRITICAL_LAG_SECONDS=300
INVALID_EVENT_RATE_WARNING=0.01
INVALID_EVENT_RATE_CRITICAL=0.05
PRODUCER_INTERVAL_SECONDS=0.2
PRODUCER_SEED=42
PRODUCER_DRIFT_AFTER_EVENTS=700
